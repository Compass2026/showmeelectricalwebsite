# Resend API key (server-side only) — required for the application form
RESEND_API_KEY=re_xxxxxxxxxxxx

# Verified sender address. Defaults to applications@send.compassmarketing.ai;
# switch to a verified showmeelectrical.com sender when ready.
RESEND_FROM=applications@send.compassmarketing.ai

# Where applications are delivered. Defaults to info@showmeelectrical.com.
APPLICATION_RECIPIENT=info@showmeelectrical.com
