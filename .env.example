# Resend API key (server-side only) — required for the application form
RESEND_API_KEY=re_xxxxxxxxxxxx

# Verified sender address. Defaults to the send.compassmarketing.ai sender
# below; switch to a verified showmeelectrical.com sender when ready.
RESEND_FROM=Show Me Electrical Careers <careers@send.compassmarketing.ai>

# Where applications are delivered (comma-separated for multiple).
APPLICATION_RECIPIENT=info@showmeelectrical.com,thomas@compassmarketing.ai

# ---- Contact form (/api/inquiry) ----
# Delivered with the same RESEND_API_KEY. Recipient owner-confirmed 2026-09-19.
INQUIRY_RECIPIENT=info@showmeelectrical.com
# Verified sender; switch to a verified showmeelectrical.com sender when ready.
INQUIRY_FROM=Show Me Electrical Website <inquiries@send.compassmarketing.ai>
# Local/preview testing only (ignored in production): "mock" returns success
# without sending, "fail" simulates a provider failure.
# INQUIRY_DELIVERY=mock

# ---- Template demonstration fixtures ----
# Build-time only. "true" includes the fictional demo fixtures under
# content/demo (e.g. /locations/westfield-demo, noindex, visibly labelled).
# Never set in a client's production environment.
# COMPASS_DEMO=true

# ---- Contact-form duplicate protection ----
# There is no local store: every send carries the submission id as the provider's
# Idempotency-Key (24 h at the provider), and the provider alone decides duplicates
# and conflicts. In mock mode (INQUIRY_DELIVERY=mock; ignored in production) the
# route talks to the QA mock provider SERVICE at this URL (`npm run qa:mock-provider`),
# which applies the same key contract; without it, an in-process mock is used.
# INQUIRY_MOCK_PROVIDER_URL=http://127.0.0.1:3999

# ---- QA ----
# Chromium/Chrome executable for scripts/qa/forms.test.mjs and browser.test.mjs.
# CHROMIUM_PATH=/usr/bin/chromium
